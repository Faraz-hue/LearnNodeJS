<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partial/head') %>
        <title>
            <%= blog.title %>
        </title>
</head>

<body class="bg-light">

    <%- include('./partial/nav') %>


        <div class="container py-5">

            <!-- Blog Section -->
            <div class="card shadow-lg border-0">

                <img src="<%= blog.coverImageURL %>" class="card-img-top" style="height:450px; object-fit:cover;"
                    alt="Blog cover">


                <div class="card-body">

                    <h1 class="fw-bold">
                        <%= blog.title %>
                    </h1>


                    <!-- Author -->
                    <div class="d-flex align-items-center mt-3">

                        <img src="<%= blog.createdBy.profileImageURL %>" width="55" height="55"
                            class="rounded-circle me-3">


                        <div>
                            <h6 class="mb-0">
                                <%= blog.createdBy.fullName %>
                            </h6>

                            <small class="text-muted">
                                Author
                            </small>
                        </div>

                    </div>



                    <!-- Edit/Delete Buttons -->
                    <% if (user && blog.createdBy._id.toString()===user._id.toString()) { %>

                        <div class="mt-4">

                            <a href="/blog/<%= blog._id %>/edit" class="btn btn-warning me-2">
                                ✏️ Edit Blog
                            </a>


                            <form action="/blog/<%= blog._id %>?_method=DELETE" method="POST" style="display:inline;">

                                <button class="btn btn-danger" onclick="return confirm('Delete this blog?')">
                                    🗑 Delete Blog
                                </button>

                            </form>

                        </div>

                        <% } %>



                            <hr>



                            <!-- Blog Content -->
                            <div class="mt-4">

                                <p style="white-space:pre-wrap; font-size:18px;">
                                    <%= blog.body %>
                                </p>

                            </div>


                </div>

            </div>




            <!-- Comments -->

            <div class="mt-5">


                <h2>
                    Comments (<%= comments.length %>)
                </h2>



                <% if (user) { %>

                    <div class="card shadow-sm mt-4">

                        <div class="card-body">

                            <form action="/blog/comment/<%= blog._id %>" method="POST">


                                <textarea name="content" class="form-control mb-3" rows="3"
                                    placeholder="Write your comment..." required></textarea>


                                <button class="btn btn-primary">
                                    Add Comment
                                </button>


                            </form>

                        </div>

                    </div>

                    <% } %>





                        <% comments.forEach(comment=> { %>


                            <div class="card shadow-sm mt-3">

                                <div class="card-body">


                                    <div class="d-flex align-items-center">


                                        <img src="<%= comment.createdBy.profileImageURL %>" width="45" height="45"
                                            class="rounded-circle me-3">


                                        <strong>
                                            <%= comment.createdBy.fullName %>
                                        </strong>


                                    </div>


                                    <p class="mt-3">
                                        <%= comment.content %>
                                    </p>


                                </div>

                            </div>


                            <% }) %>


            </div>


        </div>



        <%- include('./partial/scripts') %>

</body>

</html>